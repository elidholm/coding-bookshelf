---
import MainLayout from '../layouts/MainLayout.astro';
import BookCard from '../components/BookCard.astro';

// Get all markdown files in the books directory
const books = Object.values(import.meta.glob('./books/*.md', { eager: true }));

// Sort books by publish date (newest first)
const sortedBooks = books.sort((a, b) => {
  return new Date(b.frontmatter.publishDate).getTime() - new Date(a.frontmatter.publishDate).getTime();
});
---

<MainLayout title="Home">
  <section class="hero">
    <div class="container">
      <h1>Coding Bookshelf</h1>
      <p class="subtitle">My personal notes and reviews on programming, DevOps, and tech books</p>
    </div>
  </section>

  <section class="featured-books">
    <div class="container">
      <h2 class="section-title">Recent Book Reviews</h2>

      <div class="book-grid">
        {sortedBooks.map((book) => (
          <BookCard
            title={book.frontmatter.title}
            author={book.frontmatter.author}
            slug={book.url.split('/').pop().replace(/\.md$/, '')}
            coverImage={book.frontmatter.coverImage}
            tags={book.frontmatter.tags}
            rating={book.frontmatter.rating}
            summary={book.frontmatter.summary}
          />
        ))}
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .hero {
    position: relative;
    background: linear-gradient(135deg, var(--hero-start) 0%, var(--hero-end) 100%);
    color: #fff;
    padding: 4.5rem 0 4rem;
    text-align: center;
    margin-bottom: 4rem;
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top center, rgba(255,255,255,0.2), transparent 45%);
    pointer-events: none;
  }

  .hero .container {
    position: relative;
    z-index: 1;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    margin-bottom: 1rem;
    letter-spacing: -0.06em;
  }

  .subtitle {
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    color: rgba(255, 255, 255, 0.8);
    max-width: 820px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .featured-books {
    margin-bottom: 4rem;
  }
</style>
