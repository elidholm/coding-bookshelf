---
---

<header class="site-header">
  <div class="container">
    <a href="/coding-bookshelf" class="site-title">Coding Bookshelf</a>
    <nav aria-label="Main navigation">
      <ul class="nav-links">
        <li><a href="/coding-bookshelf">Home</a></li>
        <li><a href="/coding-bookshelf/about">About</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(20px) saturate(180%);
    background: rgba(29, 29, 31, 0.72);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.12);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 68px;
  }

  .site-title {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: #fff;
    text-decoration: none;
    transition: opacity 180ms ease;
  }

  .site-title:hover {
    opacity: 0.85;
  }

  .nav-links {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0.5rem;
  }

  .nav-links li {
    display: flex;
  }

  .nav-links a {
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    padding: 0.6rem 0.9rem;
    border-radius: 999px;
    transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    transform: translateY(-1px);
  }

  @media (max-width: 768px) {
    .container {
      min-height: 60px;
    }

    .site-title {
      font-size: 1.1rem;
    }

    .nav-links {
      gap: 0.2rem;
    }

    .nav-links a {
      padding: 0.5rem 0.7rem;
      font-size: 0.95rem;
    }
  }
</style>
