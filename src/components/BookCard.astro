---
export interface Props {
  title: string;
  author: string;
  slug: string;
  coverImage?: string;
  tags: string[];
  rating?: number;
  summary?: string;
}

const { title, author, slug, coverImage, tags, rating, summary } = Astro.props;
---

<div class="book-card">
  <a href={`/coding-bookshelf/books/${slug}`} class="book-link">
    <div class="book-cover">
      {coverImage ? (
        <img src={coverImage} alt={`Cover of ${title}`} />
      ) : (
        <div class="placeholder-cover">
          <span>{title.charAt(0)}</span>
        </div>
      )}
    </div>

    <div class="book-info">
      <h3 class="book-title">{title}</h3>
      <p class="book-author">by {author}</p>

      {rating && (
        <div class="book-rating" aria-label={`${rating} out of 5 stars`}>
          {Array(5).fill('').map((_, i) => (
            <span class={i < rating ? 'star filled' : 'star'}>★</span>
          ))}
        </div>
      )}

      <div class="book-tags">
        {tags.slice(0, 3).map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>

      {summary && (
        <p class="book-summary">{summary.length > 120 ? `${summary.substring(0, 120)}...` : summary}</p>
      )}
    </div>
  </a>
</div>

<style>
  .book-card {
    position: relative;
    border: 1px solid rgba(17, 17, 17, 0.08);
    border-radius: 22px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.82);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
    height: 100%;
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 220ms ease, border-color 220ms ease;
    will-change: transform;
  }

  .book-card:hover,
  .book-card:focus-within {
    transform: translateY(-5px) scale(1.01);
    box-shadow: 0 18px 35px rgba(15, 23, 42, 0.12);
    border-color: rgba(17, 17, 17, 0.12);
  }

  .book-card:active {
    transform: translateY(-2px) scale(0.995);
  }

  .book-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
    transition: opacity 180ms ease;
  }

  .book-link:active {
    opacity: 0.96;
  }

  .book-cover {
    display: flex;
    justify-content: center;
    height: 210px;
    overflow: hidden;
    background: linear-gradient(180deg, #f3f4f6 0%, #eef2ff 100%);
    border-bottom: 1px solid rgba(17, 17, 17, 0.04);
  }

  .book-cover img {
    width: 100%;
    max-width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 320ms ease;
  }

  .book-card:hover .book-cover img,
  .book-card:focus-within .book-cover img {
    transform: scale(1.02);
  }

  .placeholder-cover {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #64b5f6 0%, #3b82f6 100%);
  }

  .placeholder-cover span {
    font-size: 3rem;
    color: #fff;
    font-weight: 700;
    letter-spacing: -0.06em;
  }

  .book-info {
    padding: 1.4rem 1.25rem 1.3rem;
  }

  .book-title {
    margin: 0 0 0.45rem;
    font-size: 1.2rem;
    color: var(--text);
    letter-spacing: -0.03em;
  }

  .book-author {
    margin: 0 0 1rem;
    color: var(--text-secondary);
    font-style: italic;
  }

  .book-rating {
    margin-bottom: 1rem;
    letter-spacing: 0.02em;
  }

  .book-rating .star {
    font-size: 1.05rem;
  }

  .book-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1rem;
  }

  .tag {
    background: #f3f4f6;
    border: 1px solid rgba(17, 17, 17, 0.04);
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    font-size: 0.76rem;
    color: var(--text-secondary);
  }

  .book-summary {
    font-size: 0.92rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.55;
  }

  @media (prefers-reduced-motion: reduce) {
    .book-card,
    .book-card:hover,
    .book-card:active,
    .book-cover img {
      transition: none;
      transform: none;
    }
  }
</style>
